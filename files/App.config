<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>

  <!--
    Sửa lại Data Source cho đúng với SQL Server của bạn.
    - Nếu dùng SQL Server đã cài trên máy:      Data Source=.
    - Nếu dùng SQL Server Express:               Data Source=.\SQLEXPRESS
  -->
  <connectionStrings>
    <add name="QuanLyDatSanDB"
         connectionString="Data Source=.;Initial Catalog=QUANLYDATSAN;Integrated Security=True;TrustServerCertificate=True"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
</configuration>
